{
  "name": "operantkit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run wasm:copy && next dev",
    "build": "npm run wasm:copy && next build",
    "wasm:copy": "node -e \"require('fs').copyFileSync('node_modules/contingency/contingency_bg.wasm','public/contingency_bg.wasm')\"",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "wasm:build": "cd ../../core/contingency-rs && wasm-pack build --target web --release --out-dir pkg"
  },
  "dependencies": {
    "contingency": "file:../../core/contingency-rs/pkg",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
